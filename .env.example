# Atconiz production environment template
# Copy to .env and fill in real values. Never commit .env

NODE_ENV=development
PORT=3000

# Required for production
DATABASE_URL=postgresql://atconiz:atconiz@localhost:5432/atconiz?schema=public
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string

# Optional but recommended
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=

# Optional rate limit overrides
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AI_MAX=18

# Optional Redis for distributed rate limiting (future)
# REDIS_URL=

# Object storage (S3-compatible / R2 / etc.) — leave unset for local-only
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=

# Logging
# LOG_LEVEL=info
# LOG_QUERIES=0
