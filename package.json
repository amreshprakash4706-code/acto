{
  "name": "atconiz",
  "version": "4.0.0",
  "private": true,
  "description": "Atconiz — Production full-stack luxury real-estate intelligence platform",
  "main": "server/server.js",
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "NODE_ENV=production node server/server.js",
    "test": "node --test server/tests/**/*.test.js",
    "lint": "echo \"Lint placeholder - add eslint if needed\"",
    "check": "node scripts/validate.js",
    "db:generate": "prisma generate --schema=server/db/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=server/db/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=server/db/schema.prisma",
    "db:seed": "node server/db/seeds/seed.js",
    "db:studio": "prisma studio --schema=server/db/schema.prisma",
    "build": "echo \"No frontend build step (vanilla JS)\""
  },
  "keywords": [
    "real-estate",
    "ai",
    "gemini",
    "luxury",
    "atconiz",
    "nodejs",
    "postgresql"
  ],
  "author": "Amresh",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
